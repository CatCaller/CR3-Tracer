diff -ruN a/arch/x86/kvm/svm/cr3_trace.c b/arch/x86/kvm/svm/cr3_trace.c
--- a/arch/x86/kvm/svm/cr3_trace.c	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/x86/kvm/svm/cr3_trace.c	2026-09-04 11:37:12.186817016 +0200
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0
+// cr3_trace.c : host-side CR3 switch tracer for baykus.
+//
+// /dev/kvm_cr3trace : misc char device.
+//   ioctl(CR3TRACE_IOC_ARM)    - start tracing (sets CR3-write intercept on
+//                                 every vCPU of every running guest, synced
+//                                 lazily on next vmentry per-vcpu).
+//   ioctl(CR3TRACE_IOC_DISARM) - stop tracing, restore default (no-intercept)
+//                                 NPT fast path.
+//   ioctl(CR3TRACE_IOC_FLUSH)  - drop buffered-but-unread events.
+//   read()                     - blocking, returns whole struct kvm_cr3_event
+//                                 records (caller must pass a buffer sized
+//                                 as a multiple of sizeof(struct kvm_cr3_event)).
+//   poll()                     - POLLIN when events are available.
+//
+// Tracing auto-disarms when the last open fd on the device is closed, so a
+// forgotten logger process can't leave interception running forever.
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/miscdevice.h>
+#include <linux/kfifo.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <linux/poll.h>
+#include <linux/uaccess.h>
+#include <linux/ktime.h>
+#include <linux/fs.h>
+
+#include "cr3_trace.h"
+
+bool kvm_cr3_trace_enabled __read_mostly;
+EXPORT_SYMBOL_GPL(kvm_cr3_trace_enabled);
+
+#define CR3_FIFO_SIZE 4096 /* must be power of 2 */
+
+static DEFINE_KFIFO(cr3_fifo, struct kvm_cr3_event, CR3_FIFO_SIZE);
+static DEFINE_SPINLOCK(cr3_fifo_lock);
+static DECLARE_WAIT_QUEUE_HEAD(cr3_wq);
+static atomic_t cr3trace_open_count = ATOMIC_INIT(0);
+
+void kvm_cr3_trace_report(u32 vcpu_id, u64 old_cr3, u64 new_cr3)
+{
+	struct kvm_cr3_event ev;
+	unsigned long flags;
+	unsigned int put;
+
+	if (old_cr3 == new_cr3)
+		return;
+
+	ev.ns = ktime_get_ns();
+	ev.vcpu_id = vcpu_id;
+	ev.pad = 0;
+	ev.old_cr3 = old_cr3;
+	ev.new_cr3 = new_cr3;
+
+	spin_lock_irqsave(&cr3_fifo_lock, flags);
+	put = kfifo_in(&cr3_fifo, &ev, 1);
+	spin_unlock_irqrestore(&cr3_fifo_lock, flags);
+
+	if (!put) {
+		pr_warn_ratelimited("kvm_cr3trace: ring full, dropping event\n");
+		return;
+	}
+
+	wake_up_interruptible(&cr3_wq);
+}
+EXPORT_SYMBOL_GPL(kvm_cr3_trace_report);
+
+static int cr3trace_open(struct inode *inode, struct file *f)
+{
+	atomic_inc(&cr3trace_open_count);
+	return 0;
+}
+
+static int cr3trace_release(struct inode *inode, struct file *f)
+{
+	if (atomic_dec_and_test(&cr3trace_open_count))
+		WRITE_ONCE(kvm_cr3_trace_enabled, false);
+	return 0;
+}
+
+static ssize_t cr3trace_read(struct file *f, char __user *ubuf, size_t count, loff_t *ppos)
+{
+	struct kvm_cr3_event ev;
+	size_t n = 0;
+	int ret;
+
+	if (count < sizeof(ev))
+		return -EINVAL;
+
+	if (kfifo_is_empty(&cr3_fifo)) {
+		if (f->f_flags & O_NONBLOCK)
+			return -EAGAIN;
+		ret = wait_event_interruptible(cr3_wq, !kfifo_is_empty(&cr3_fifo));
+		if (ret)
+			return ret;
+	}
+
+	while (n + sizeof(ev) <= count) {
+		unsigned long flags;
+		unsigned int got;
+
+		spin_lock_irqsave(&cr3_fifo_lock, flags);
+		got = kfifo_out(&cr3_fifo, &ev, 1);
+		spin_unlock_irqrestore(&cr3_fifo_lock, flags);
+
+		if (!got)
+			break;
+
+		if (copy_to_user(ubuf + n, &ev, sizeof(ev)))
+			return n ? n : -EFAULT;
+
+		n += sizeof(ev);
+	}
+
+	return n;
+}
+
+static __poll_t cr3trace_poll(struct file *f, poll_table *wait)
+{
+	poll_wait(f, &cr3_wq, wait);
+	return kfifo_is_empty(&cr3_fifo) ? 0 : (POLLIN | POLLRDNORM);
+}
+
+static long cr3trace_ioctl(struct file *f, unsigned int cmd, unsigned long arg)
+{
+	unsigned long flags;
+
+	switch (cmd) {
+	case CR3TRACE_IOC_ARM:
+		WRITE_ONCE(kvm_cr3_trace_enabled, true);
+		return 0;
+	case CR3TRACE_IOC_DISARM:
+		WRITE_ONCE(kvm_cr3_trace_enabled, false);
+		return 0;
+	case CR3TRACE_IOC_FLUSH:
+		spin_lock_irqsave(&cr3_fifo_lock, flags);
+		kfifo_reset(&cr3_fifo);
+		spin_unlock_irqrestore(&cr3_fifo_lock, flags);
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations cr3trace_fops = {
+	.owner          = THIS_MODULE,
+	.open           = cr3trace_open,
+	.release        = cr3trace_release,
+	.read           = cr3trace_read,
+	.poll           = cr3trace_poll,
+	.unlocked_ioctl = cr3trace_ioctl,
+	.llseek         = no_llseek,
+};
+
+static struct miscdevice cr3trace_miscdev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name  = "kvm_cr3trace",
+	.fops  = &cr3trace_fops,
+	.mode  = 0600,
+};
+
+int __init kvm_cr3_trace_init(void)
+{
+	return misc_register(&cr3trace_miscdev);
+}
+
+void kvm_cr3_trace_exit(void)
+{
+	WRITE_ONCE(kvm_cr3_trace_enabled, false);
+	misc_deregister(&cr3trace_miscdev);
+}
diff -ruN a/arch/x86/kvm/svm/cr3_trace.h b/arch/x86/kvm/svm/cr3_trace.h
--- a/arch/x86/kvm/svm/cr3_trace.h	1970-01-01 01:00:00.000000000 +0100
+++ b/arch/x86/kvm/svm/cr3_trace.h	2026-09-04 11:37:12.186817016 +0200
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+// cr3_trace.h : host-side CR3 switch tracer for baykus.
+//
+// Exposes a misc device (/dev/kvm_cr3trace) that userspace arms/disarms via
+// ioctl, then reads a stream of fixed-size KVM_CR3_EVENT records from,
+// blocking until new events arrive. Tracing is fully off (zero VM-exit
+// overhead) until a userspace consumer explicitly arms it.
+
+#ifndef __KVM_SVM_CR3_TRACE_H
+#define __KVM_SVM_CR3_TRACE_H
+
+#include <linux/types.h>
+#include <linux/ioctl.h>
+
+/* One CR3 switch, as delivered to userspace via read(). Fixed size, no
+ * padding surprises: explicit u64/u32 fields only. */
+struct kvm_cr3_event {
+	__u64 ns;         /* CLOCK_MONOTONIC-ish timestamp (ktime_get_ns()) */
+	__u32 vcpu_id;
+	__u32 pad;
+	__u64 old_cr3;
+	__u64 new_cr3;
+};
+
+#define CR3TRACE_IOC_MAGIC	0xC3
+
+/* Arm/disarm tracing for every vCPU of every running guest. Idempotent. */
+#define CR3TRACE_IOC_ARM	_IO(CR3TRACE_IOC_MAGIC, 1)
+#define CR3TRACE_IOC_DISARM	_IO(CR3TRACE_IOC_MAGIC, 2)
+
+/* Drop all currently-buffered events without reading them. */
+#define CR3TRACE_IOC_FLUSH	_IO(CR3TRACE_IOC_MAGIC, 3)
+
+#if defined(__KERNEL__)
+
+/* Read with READ_ONCE() from noinstr code (svm_vcpu_enter_exit) to decide
+ * whether to sync this vCPU's CR3-write intercept. Never call functions
+ * from noinstr context to check this - just read the bool directly. */
+extern bool kvm_cr3_trace_enabled;
+
+/* Called from cr_interception() (regular, non-noinstr context) right after
+ * a guest CR3 write has been accepted. No-op if not armed or if old==new. */
+void kvm_cr3_trace_report(u32 vcpu_id, u64 old_cr3, u64 new_cr3);
+
+int __init kvm_cr3_trace_init(void);
+void kvm_cr3_trace_exit(void);
+
+#endif /* __KERNEL__ */
+
+#endif /* __KVM_SVM_CR3_TRACE_H */
